+// "<stem>_data.mem": one "addr data" hex pair per line, both 16-bit. addr is
+// the word address the kernel computes; data is the halfword it should read.
+void load_data_image(const std::string& path) {
+  std::ifstream stream(path);
+  if (!stream) {
+    throw std::runtime_error("Could not open data image '" + path + "'");
+  }
+  std::string line;
+  while (std::getline(stream, line)) {
+    line = trim(line);
+    if (line.empty() || line[0] == '/' || line[0] == '#') {
+      continue;
+    }
+    std::stringstream ss(line);
+    std::string addr_text;
+    std::string data_text;
+    ss >> addr_text >> data_text;
+    if (addr_text.empty() || data_text.empty()) {
+      continue;
+    }
+    const auto addr = static_cast<std::uint32_t>(std::stoul(addr_text, nullptr, 16));
+    const auto data = static_cast<std::uint32_t>(std::stoul(data_text, nullptr, 16));
+    g_data_words[addr] = data & 0xFFFFu;
+  }
+  g_have_data_image = true;
+}
